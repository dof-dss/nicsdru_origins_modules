<?php

/**
 * Implements hook_install().
 */
function origins_qa_install() {
  $qa_role = \Drupal::entityTypeManager()->getStorage('user_role')->load('qa');

  // Create a new 'qa' role as one wasn't found.
  if (empty($qa_role)) {
    $qa_role = \Drupal\user\Entity\Role::create([
      'id' => 'qa',
      'label' => 'Quality Assurance',
    ]);

    $qa_role->save();
  }
}

use Drupal\Core\Link;

/**
 * Install the Ultimate Cron job for blocking QA accounts.
 */
function origins_qa_update_10001() {
  \Drupal::service('config.installer')->installOptionalConfig(NULL, ['module' => 'origins_qa']);
}

/**
 * Set the email address of QA accounts to eddtest+<account name>@finance-ni.gov.uk.
 */
function origins_qa_update_10002() {
  $accounts = \Drupal::entityTypeManager()
    ->getStorage('user')
    ->loadByProperties(['roles' => 'qa']);

  $email_validator = \Drupal::service('email.validator');
  $updated = 0;

  foreach ($accounts as $account) {
    /** @var \Drupal\user\UserInterface $account */
    // Whitespace is not valid in the local part of an email address.
    $name = preg_replace('/\s+/', '.', $account->getAccountName());
    $email = 'eddtest+' . $name . '@finance-ni.gov.uk';

    if (!$email_validator->isValid($email)) {
      \Drupal::logger('origins_qa')->warning('Unable to set a valid email for QA account @name (@uid).', [
        '@name' => $account->getAccountName(),
        '@uid' => $account->id(),
      ]);
      continue;
    }

    if ($account->getEmail() !== $email) {
      $account->setEmail($email)->save();
      $updated++;
    }
  }

  return t('Updated the email address of @count QA accounts.', ['@count' => $updated]);
}

/**
 * Implements hook_requirements().
 */
function origins_qa_requirements($phase) {
  $requirements = [];

  if ($phase == 'runtime') {
    $accounts = \Drupal::entityTypeManager()
      ->getListBuilder('user')
      ->getStorage()
      ->loadByProperties([
        'roles' => 'qa'
      ]);

    if (!empty($accounts)) {
      $active = 0;
      foreach ($accounts as $account) {
        /** @var \Drupal\user\UserInterface $account */
        ($account->isActive()) ? $active++ : NULL;
      }

      $summary = t('@active active of @total QA accounts.', [
        '@active' => $active,
        '@total' => count($accounts),
      ]);

      $description = [
        '#markup' => t('These should be removed or disabled on production sites. @link', [
          '@link' => Link::createFromRoute('QA account list', 'origins_qa.manager.list')->toString()
        ])
      ];

      $requirements['origins_qa'] = [
        'title' => t('Origins QA accounts'),
        'severity' => REQUIREMENT_WARNING,
        'value' => $summary,
        'description' => $description,
      ];
    }
  }

  return $requirements;
}
