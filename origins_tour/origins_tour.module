<?php

/**
 * @file
 * Primary module hooks for Origins Tour module.
 */

/**
 * Implements hook_theme().
 */
function origins_tour_theme() {
    return [
        'help_homepage' => [
            'template' => 'index',
            'variables' => [
                'sitename' => \Drupal::config('system.site')->get('name'),
            ],
        ],
        'tours' => [
            'template' => 'tours',
            'variables' => [
                'tours' => [],
            ],
        ],
    ];
}

/**
 * Implements hook_page_attachments().
 */
function origins_tour_page_attachments(array &$attachments) {

    $site_name = \Drupal::config('system.site')->get('name');

    if (empty($site_name)) {
        $site_name = \Drupal::request()->getHost();
    }

    $attachments['#attached']['library'][] = 'origins_tour/tour_modal';

    // DO NOT fake tour name here
    $attachments['#attached']['drupalSettings']['originsTour'] = [
        'siteName' => $site_name,
        'tourName' => '',
    ];
}

/**
 * Implements hook_mail().
 */
function origins_tour_mail($key, &$message, $params) {
    switch ($key) {

        case 'tour_feedback':
            $message['subject'] = 'Tour Feedback: ' . $params['tour_name'];

            $message['body'][] =
                "Site: {$params['site_name']}\n" .
                "Tour: {$params['tour_name']}\n" .
                "Page: {$params['page_url']}\n\n" .
                "Feedback:\n{$params['message']}";

            break;
    }
}