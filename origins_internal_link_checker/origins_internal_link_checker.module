<?php

/**
 * @file
 * Contains origins_internal_link_checker.module.
 */

use Drupal\Core\Entity\EntityInterface;

/**
 * Implements hook_entity_presave().
 */
function origins_internal_link_checker_entity_presave(EntityInterface $entity): void {
  \Drupal::service('origins_internal_link_checker.processor')
    ->processEntity($entity);
}
